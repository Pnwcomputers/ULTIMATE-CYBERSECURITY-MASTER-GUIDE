# Example deployment when nzyme node, webhook receiver, and Wazuh agent
# share the same Linux network namespace. The installed Wazuh account reads the event log.
# Store the token only in a root-owned environment file.
[Unit]
Description=nzyme webhook to Wazuh JSONL receiver (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wazuh
Group=wazuh
EnvironmentFile=/etc/nzyme-wazuh/receiver.env
ExecStart=/usr/bin/python3 /opt/nzyme-wazuh/nzyme_webhook_bridge.py --port 8787
Restart=on-failure
RestartSec=5
UMask=0027
LogsDirectory=nzyme-wazuh
LogsDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
