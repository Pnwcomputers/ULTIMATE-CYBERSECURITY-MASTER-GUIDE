<!-- Wazuh custom rules for normalized nzyme webhook events.
     Distinct from Kismet rules, using 100350-100354. Test on manager. -->
<group name="wireless_wids,">
  <rule id="100350" level="3">
    <decoded_as>json</decoded_as>
    <field name="wids.integration">^nzyme$</field>
    <description>WIDS: nzyme event $(wids.event) (classification pending)</description>
    <group>wireless_wids,nzyme,</group>
  </rule>
  <rule id="100351" level="5">
    <if_sid>100350</if_sid>
    <field name="wids.category">^unclassified_detection$</field>
    <description>WIDS: nzyme detection; inspect event_type and alert context</description>
    <group>wireless_wids,nzyme_detection,</group>
  </rule>
  <rule id="100352" level="10">
    <if_sid>100350</if_sid>
    <field name="wids.category">^disconnect_anomaly$</field>
    <description>WIDS: nzyme disconnection anomaly; verify AP maintenance and clients</description>
    <group>wireless_wids,nzyme_disconnect,</group>
  </rule>
  <rule id="100353" level="10">
    <if_sid>100350</if_sid>
    <field name="wids.category">^rogue_ap_anomaly$</field>
    <description>WIDS: nzyme AP/network anomaly; investigate spoofing indicators</description>
    <group>wireless_wids,nzyme_rogue_ap,</group>
  </rule>
  <rule id="100354" level="5">
    <if_sid>100350</if_sid>
    <field name="wids.category">^system_event$</field>
    <description>WIDS: nzyme operational/system event</description>
    <group>wireless_wids,nzyme_health,</group>
  </rule>
</group>
