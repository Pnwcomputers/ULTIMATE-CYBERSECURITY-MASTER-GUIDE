# Consistent cross-platform source checkout; no automatic rewriting of old files.
* text=auto
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.tsv text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.s1p text eol=lf
