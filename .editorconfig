root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{py,sh,ps1,yml,yaml,json,jsonc}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{go,c}]
indent_style = tab

[Makefile]
indent_style = tab

[*.tsv]
indent_style = tab
trim_trailing_whitespace = false
